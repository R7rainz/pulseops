{
  "name": "@pulseops/cli",
  "version": "0.1.0",
  "description": "Official command-line client for the PulseOps programmatic API.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "pulseops": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./config": "./dist/config.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "openapi-typescript \"${PULSEOPS_API_URL:-http://localhost:4000}/docs/openapi.json\" -o src/generated/schema.d.ts",
    "build": "tsc",
    "dev": "node --experimental-strip-types --no-warnings src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openapi-typescript": "^7.5.0",
    "typescript": "^6.0.3"
  }
}
