# pulseops CLI / TUI environment (all optional).
#
# The CLI resolves settings as: flag > env var > stored `pulseops login` > default.
# Prefer `pulseops login` for interactive use; the env vars below suit CI/scripts.

# API base URL of your (self-hosted) PulseOps backend.
PULSEOPS_API_URL=http://localhost:4000

# Workspace API key (po_…). Non-interactive, read-only, scoped to one workspace.
# Takes precedence over a stored login. Leave unset if you use `pulseops login`.
PULSEOPS_API_KEY=
# Required with an API key (keys are scoped to a single workspace).
PULSEOPS_WORKSPACE=

# Advanced: override where credentials/settings are stored
# (default ~/.config/pulseops, or $XDG_CONFIG_HOME/pulseops).
# PULSEOPS_CONFIG_DIR=

# Set NO_COLOR=1 to disable coloured output (also auto-disabled when piped).
# NO_COLOR=
