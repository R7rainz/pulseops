{
  "name": "@pulseops/tui",
  "version": "0.1.0",
  "description": "Terminal dashboard for PulseOps, built on Ink over the @pulseops/cli client.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "pulseops-tui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pulseops/cli": "file:../cli",
    "ink": "^5.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
