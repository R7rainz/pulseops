# PulseOps ping engine (Go) environment.
#
# Consumes due-monitor "targets" from Kafka, pings them concurrently, and
# publishes check "metrics" back. Values must match the backend's KAFKA_* config.
# In Docker Compose these are injected by docker-compose.yml.

# Kafka broker list (host:port, comma-separated).
KAFKA_BROKERS=localhost:9092
# Topics — must match the backend.
KAFKA_TARGETS_TOPIC=pulseops.monitors.targets
KAFKA_METRICS_TOPIC=pulseops.monitors.metrics
# Consumer group for the ping workers.
KAFKA_CONSUMER_GROUP=pulseops-ping-workers
# How many monitors to ping in parallel.
CONCURRENT_WORKERS=50
