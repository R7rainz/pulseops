# PulseOps frontend (Next.js) environment.
#
# Copy to `.env` for local `pnpm dev`:  cp .env.example .env
# In Docker Compose these are provided by docker-compose.yml (API_URL) and baked
# in as build args (the NEXT_PUBLIC_* ones).

# Server-side base URL for the API (SSR + server actions + route handlers reach
# the backend over the internal network in Docker; localhost in dev).
API_URL=http://localhost:4000

# ⚠️ BUILD-TIME: NEXT_PUBLIC_* are inlined into the client bundle at `next build`,
# so they must be set BEFORE building — changing them later means rebuilding,
# not just restarting.
#
# Browser-facing API base (what the user's browser calls directly).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where the API-reference docs app is served (the "API docs ↗" link).
NEXT_PUBLIC_DOCS_URL=http://localhost:3001
