{
  "openapi": "3.0.3",
  "info": {
    "title": "PulseOps API",
    "description": "Programmatic access to PulseOps monitors and incidents. Authenticate with a workspace API key via the `x-api-key` header (create one in Settings → API Keys). v1 keys are read-only.",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header",
        "description": "Workspace API key (prefixed `po_`)."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Session token used by the PulseOps web app."
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/v1/workspaces/{workspaceId}/monitors": {
      "get": {
        "summary": "List monitors",
        "tags": [
          "Monitors"
        ],
        "description": "Returns every monitor in the workspace.",
        "parameters": [
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          }
        ],
        "security": [
          {
            "apiKey": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/monitors/live": {
      "get": {
        "summary": "Live monitor state",
        "tags": [
          "Monitors"
        ],
        "description": "Returns the latest cached status/latency for each active monitor, keyed by monitor id.",
        "parameters": [
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          }
        ],
        "security": [
          {
            "apiKey": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/monitors/{monitorId}/checks": {
      "get": {
        "summary": "List monitor checks",
        "tags": [
          "Monitors"
        ],
        "description": "Paginated history of check results for a monitor.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 20
            },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "in": "query",
            "name": "offset",
            "required": false
          },
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          },
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "monitorId",
            "required": true
          }
        ],
        "security": [
          {
            "apiKey": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/monitors/{monitorId}/stats": {
      "get": {
        "summary": "Monitor statistics",
        "tags": [
          "Monitors"
        ],
        "description": "Uptime and latency percentiles (all-time, 24h and 30d windows) for a monitor.",
        "parameters": [
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          },
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "monitorId",
            "required": true
          }
        ],
        "security": [
          {
            "apiKey": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/monitors/{monitorId}": {
      "get": {
        "summary": "Get a monitor",
        "tags": [
          "Monitors"
        ],
        "description": "Returns a single monitor by id.",
        "parameters": [
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          },
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "monitorId",
            "required": true
          }
        ],
        "security": [
          {
            "apiKey": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/monitors/{monitorId}/analytics": {
      "get": {
        "summary": "Monitor SLA analytics",
        "tags": [
          "Monitors"
        ],
        "description": "30-day uptime %, outage count, downtime minutes and 24h average latency.",
        "parameters": [
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          },
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "monitorId",
            "required": true
          }
        ],
        "security": [
          {
            "apiKey": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/monitors/{monitorId}/heartbeat": {
      "post": {
        "summary": "Send a heartbeat",
        "tags": [
          "Heartbeat"
        ],
        "description": "Push endpoint for HEARTBEAT monitors. Call this on your schedule to keep the monitor UP; a missed heartbeat past the grace period opens an incident.",
        "parameters": [
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "monitorId",
            "required": true
          }
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/incidents": {
      "get": {
        "summary": "List incidents",
        "tags": [
          "Incidents"
        ],
        "description": "Returns every incident in the workspace, newest first.",
        "parameters": [
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          }
        ],
        "security": [
          {
            "apiKey": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/incidents/{incidentId}": {
      "get": {
        "summary": "Get an incident",
        "tags": [
          "Incidents"
        ],
        "description": "Returns a single incident by id, with its monitor.",
        "parameters": [
          {
            "schema": {
              "type": "integer"
            },
            "in": "path",
            "name": "incidentId",
            "required": true
          }
        ],
        "security": [
          {
            "apiKey": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    }
  ],
  "tags": [
    {
      "name": "Monitors",
      "description": "Monitor config, live state, checks, stats and SLA analytics."
    },
    {
      "name": "Incidents",
      "description": "Incident history."
    },
    {
      "name": "Heartbeat",
      "description": "Push liveness signals for HEARTBEAT monitors."
    }
  ]
}
