# PulseOps API-reference app (Next.js + Scalar) environment.
#
# Copy to `.env` for local `pnpm dev`:  cp .env.example .env
# In Docker Compose these are provided by docker-compose.yml (API_URL) and the
# prod overlay (the NEXT_PUBLIC_* build args).

# Server-side: where the same-origin /openapi.json proxy fetches the spec from
# (the backend, over the internal network in Docker; localhost in dev).
API_URL=http://localhost:4000

# ⚠️ BUILD-TIME (inlined at `next build`):
# The "← Back to app" link target.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Serve the app under a sub-path (e.g. /docs) when behind the reverse proxy.
# Empty = served at the root (the default for local dev).
NEXT_PUBLIC_BASE_PATH=
