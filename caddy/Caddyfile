# Reverse proxy + automatic HTTPS for a real-domain PulseOps deploy.
# Used only with docker-compose.prod.yml. Caddy provisions and renews a
# Let's Encrypt certificate for $DOMAIN automatically (needs public DNS
# pointing at this host and inbound 80/443 open).
#
# Path-based routing on one domain:
#   /api/v1/*  → backend API (also OAuth callbacks, which live under /api/v1/auth)
#   /docs*     → API-reference app (built with basePath=/docs)
#   /*         → the Next web app (incl. its own /api/auth, /api/monitors BFF routes)
#
# To receive certificate-expiry notices, uncomment the global block and set
# ACME_EMAIL in your .env. Caddy works without it (just no email account).
# {
# 	email {$ACME_EMAIL}
# }

{$DOMAIN} {
	# Backend: the programmatic API and OAuth callbacks are all under /api/v1.
	# The web app's own /api/* handlers (no v1) fall through to the catch-all.
	handle /api/v1/* {
		reverse_proxy api:4000
	}

	# API-reference docs app. It's built with Next basePath=/docs, so its pages,
	# assets (/docs/_next/*) and spec proxy (/docs/openapi.json) all live under
	# /docs — forward the prefix untouched.
	handle /docs* {
		reverse_proxy docs:3000
	}

	# Everything else: the Next web app.
	handle {
		reverse_proxy web:3000
	}

	encode zstd gzip
}
