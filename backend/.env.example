# PulseOps backend (Fastify API) environment.
#
# Copy to `.env` for local `pnpm dev`:  cp .env.example .env
# In Docker Compose the core values are injected by docker-compose.yml — you only
# need a `.env` here to enable the OPTIONAL features (OAuth / SMTP / billing).

# ── Core (required) ───────────────────────────────────────────────────────────
# Postgres connection string.
DATABASE_URL=postgresql://pulseops:pulseops@localhost:5432/pulseops
# Auth signing key (HS256, also signs 5-min MFA challenge tokens).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=
# HTTP server bind.
PORT=4000
HOST=0.0.0.0

# ── Infrastructure ────────────────────────────────────────────────────────────
# Redis (BullMQ webhook-retry queue, live monitor cache, OAuth state).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Kafka (must match ../workers/ping-engine). Brokers = host:port list.
KAFKA_BROKERS=localhost:9092
KAFKA_TARGETS_TOPIC=pulseops.monitors.targets
KAFKA_METRICS_TOPIC=pulseops.monitors.metrics

# ── Public URLs ───────────────────────────────────────────────────────────────
# APP_URL / FRONTEND_URL — where the web app is served (email links + CORS
# allowlist; FRONTEND_URL is comma-separated, first entry is the OAuth redirect
# base). PUBLIC_API_URL / OAUTH_CALLBACK_BASE — where the API is reachable.
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
OAUTH_CALLBACK_BASE=http://localhost:4000

# ── Optional: social login ────────────────────────────────────────────────────
# Each provider is optional; unset ⇒ its button 302s to /login?error=oauth_unavailable.
# Register the redirect URI  <OAUTH_CALLBACK_BASE>/api/v1/auth/oauth/<provider>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ── Optional: email (transactional) ───────────────────────────────────────────
# Invites, password resets, magic links. Unset ⇒ links are logged to the API
# console instead (dev-friendly).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Optional: billing (Razorpay) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
