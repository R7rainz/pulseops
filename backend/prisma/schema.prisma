// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int      @id @default(autoincrement())
  name                String?
  email               String   @unique
  passwordHash        String?
  emailVerified       Boolean  @default(false)
  totpSecret          String?
  totpEnabled         Boolean  @default(false)
  resetPasswordToken  String?
  resetPasswordExpires DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspaceMembers WorkspaceMember[]
  sessions         Session[]
  oauthAccounts    OAuthAccount[]
  mfaRecoveryCodes MfaRecoveryCode[]
  acknowledgedIncidents Incident[] @relation("IncidentAcknowledger")
}

// Rotating refresh-token sessions. The opaque refresh token is never stored;
// only its sha256 hash. Rotation revokes the old row and inserts a new one;
// logout sets revokedAt so a token can be invalidated before it expires.
model Session {
  id               String    @id @default(cuid())
  userId           Int
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  MICROSOFT
}

model OAuthAccount {
  id                Int           @id @default(autoincrement())
  userId            Int
  provider          OAuthProvider
  providerAccountId String
  email             String?
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// One-time recovery codes for TOTP 2FA. Only the sha256 hash is stored;
// codes are shown to the user once at enable time.
model MfaRecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Passwordless magic-link tokens. Only the sha256 hash is stored; single-use
// (usedAt) with a short expiry.
model MagicLinkToken {
  id        Int       @id @default(autoincrement())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  planTier           String   @default("FREE")
  razorpayCustomerId String?
  razorpaySubId      String?
  subscriptionStatus String?

  members              WorkspaceMember[]
  monitors             Monitor[]
  webhookEndpoints     WebhookEndpoint[]
  apiKeys              ApiKey[]
  workspaceInvites     WorkspaceInvite[]
  processedPayments    ProcessedPayment[]
  notificationChannels NotificationChannel[]
}

// Where alerts go. Until now the only transport was a generic HTTP webhook
// carrying a PulseOps-shaped payload — so users could not get an email, and
// could not point it at a Slack/Discord incoming webhook and have it render.
//
// `config` holds the per-type settings (see channels/ for the shape each
// adapter expects): EMAIL {to}, SLACK/DISCORD {webhookUrl}, PAGERDUTY
// {routingKey}, WEBHOOK {url, secret}.
model NotificationChannel {
  id          Int                     @id @default(autoincrement())
  workspaceId Int
  type        NotificationChannelType
  name        String
  config      Json
  events      String[]
  isActive    Boolean                 @default(true)
  // Consecutive delivery failures. Used to trip a circuit breaker so a
  // permanently dead endpoint isn't retried on every single incident forever.
  failureCount    Int       @default(0)
  disabledUntil   DateTime?
  lastDeliveredAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  workspace Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries NotificationDeliveryLog[]

  @@index([workspaceId])
}

model NotificationDeliveryLog {
  id             BigInt   @id @default(autoincrement())
  channelId      Int
  event          String
  isSuccess      Boolean
  responseStatus Int?
  detail         String?
  createdAt      DateTime @default(now())

  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

// Replay guard for Razorpay. Both the client-side verify callback and the
// server-side webhook record the provider's event/payment id here before
// acting on it; the unique constraint makes a re-POSTed (or redelivered)
// payload a no-op instead of a second upgrade.
model ProcessedPayment {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  reference   String   @unique
  kind        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceMember {
  id          Int           @id @default(autoincrement())
  userId      Int
  workspaceId Int
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

enum MonitorStatus {
  UP
  DOWN
  DEGRADED
  PAUSED
}

enum MonitorType {
  HTTP
  HEARTBEAT
}

model Monitor {
  id                  Int           @id @default(autoincrement())
  workspaceId         Int
  name                String
  type                MonitorType   @default(HTTP)
  url                 String
  method              String        @default("GET")
  intervalSeconds     Int           @default(60)
  timeoutMs           Int           @default(5000)
  expectedStatus      Int           @default(200)
  gracePeriodSeconds  Int           @default(60)
  status              MonitorStatus @default(UP)
  consecutiveFailures Int           @default(0)
  graceThreshold      Int           @default(3)
  isActive            Boolean       @default(true)
  lastCheckedAt       DateTime?
  lastResponseTime    Int?
  lastStatusCode      Int?
  lastHeartbeatAt     DateTime?
  tlsIssuer           String?
  tlsValidTo          DateTime?
  tlsDaysRemaining    Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  maintenanceStartAt  DateTime?
  maintenanceEndAt    DateTime?
  // When this monitor is next due. Lets the scheduler ask Postgres for exactly
  // the due rows instead of loading every active monitor and filtering in
  // application memory on each 15s tick.
  nextCheckAt         DateTime?
  // Set when a check is dispatched, cleared when its result lands. Stops a
  // monitor slower than the tick interval from being dispatched repeatedly.
  dispatchedAt        DateTime?
  // Alert suppression. `graceThreshold` (consecutive failures) was the only
  // debounce, so a flapping monitor could page repeatedly.
  //   alertCooldownSeconds — minimum gap between alerts for this monitor
  //   reminderIntervalSeconds — re-notify cadence while an incident stays open
  //                             (0 disables reminders)
  //   mutedUntil — user-set snooze; checks keep running, alerts don't fire
  alertCooldownSeconds    Int       @default(300)
  reminderIntervalSeconds Int       @default(0)
  mutedUntil              DateTime?
  lastAlertAt             DateTime?

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checks       MonitorCheck[]
  dailyRollups MonitorCheckDaily[]
  incidents    Incident[]

  @@index([workspaceId])
  // The scheduler's hot query: active, due, not already in flight.
  @@index([isActive, nextCheckAt])
}

// The highest-volume table in the system: one row per check, per monitor. At
// the 30s minimum interval a single monitor writes ~2.9M rows/year, so the id
// is BigInt (an Int4 sequence tops out at 2.147B and would overflow) and the
// retention job in telemetry/retention.ts prunes raw rows once they've been
// rolled up into MonitorCheckDaily.
model MonitorCheck {
  id             BigInt        @id @default(autoincrement())
  monitorId      Int
  status         MonitorStatus
  statusCode     Int?
  responseTimeMs Int?
  errorMessage   String?
  checkedAt      DateTime      @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // Every hot query is "this monitor, newest first" or "these monitors, since
  // T" — a composite index serves both. The bare [monitorId] index it replaces
  // forced a sort over the whole monitor's history.
  @@index([monitorId, checkedAt])
  @@index([checkedAt])
}

// Daily per-monitor rollup of MonitorCheck. Long-range views (30d analytics,
// the 90d public status page) read this instead of scanning raw checks, which
// is what lets retention drop the raw rows.
model MonitorCheckDaily {
  id            BigInt   @id @default(autoincrement())
  monitorId     Int
  day           DateTime @db.Date
  totalChecks   Int
  upChecks      Int
  downChecks    Int
  degradedChecks Int
  avgResponseMs Int?
  minResponseMs Int?
  maxResponseMs Int?
  p50ResponseMs Int?
  p95ResponseMs Int?
  p99ResponseMs Int?
  createdAt     DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([monitorId, day])
  @@index([day])
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Incident {
  id         Int            @id @default(autoincrement())
  monitorId  Int
  status     IncidentStatus @default(OPEN)
  title      String
  startedAt  DateTime       @default(now())
  resolvedAt DateTime?
  // ACKNOWLEDGED existed as a status with no record of who acknowledged it or
  // when, so "someone is on this" couldn't actually be attributed.
  acknowledgedAt DateTime?
  acknowledgedBy Int?
  // When the last "still down" reminder went out, so reminders fire on a
  // cadence instead of every sweep.
  lastReminderAt DateTime?

  monitor        Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  acknowledgedByUser User? @relation("IncidentAcknowledger", fields: [acknowledgedBy], references: [id], onDelete: SetNull)

  @@index([monitorId])
  @@index([status])
  // Incident lists are always ordered by startedAt desc.
  @@index([startedAt])
}

enum ApiKeyScope {
  READ_ONLY
  READ_WRITE
}

enum NotificationChannelType {
  EMAIL
  SLACK
  DISCORD
  PAGERDUTY
  WEBHOOK
}

// API keys are stored hashed, never raw — the plaintext is shown exactly once
// at creation. `keyPrefix` is the non-secret leading fragment, kept so the UI
// can identify a key ("po_a1b2c3…") without being able to reconstruct it.
model ApiKey {
  id          Int         @id @default(autoincrement())
  workspaceId Int
  name        String
  keyHash     String      @unique
  keyPrefix   String
  scope       ApiKeyScope @default(READ_ONLY)
  lastUsedAt  DateTime?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WebhookEndpoint {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  name        String   @default("")
  url         String
  events      String   @default("[\"incident.opened\",\"incident.resolved\"]")
  secret      String?
  isActive    Boolean  @default(true)
  lastTestedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  webhookDeliveryLogs WebhookDeliveryLog[]

  @@index([workspaceId])
}

model WebhookDeliveryLog {
  id             BigInt   @id @default(autoincrement())
  webhookId      Int
  url            String
  requestPayload Json
  responseStatus Int?
  responseBody   String?
  isSuccess      Boolean
  createdAt      DateTime @default(now())

  webhook WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  // Also unbounded, and previously had no index at all — the delivery-log view
  // was a sequential scan.
  @@index([webhookId, createdAt])
}

// An invite is one of two kinds, distinguished by `email`:
//   - Email invite (email set): targeted, single-use — consumed on accept.
//   - Shareable link (email null): Discord-style, multi-use until it expires,
//     is revoked, or hits maxUses.
// `expiresAt` null means "never expires". `maxUses` null means unlimited.
model WorkspaceInvite {
  id            Int           @id @default(autoincrement())
  workspaceId   Int
  token         String        @unique
  email         String?
  role          WorkspaceRole @default(VIEWER)
  expiresAt     DateTime?
  maxUses       Int?
  useCount      Int           @default(0)
  invitedByName String?
  createdAt     DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId])
  @@index([email])
}
