// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int      @id @default(autoincrement())
  name                String?
  email               String   @unique
  passwordHash        String?
  emailVerified       Boolean  @default(false)
  totpSecret          String?
  totpEnabled         Boolean  @default(false)
  resetPasswordToken  String?
  resetPasswordExpires DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspaceMembers WorkspaceMember[]
  sessions         Session[]
  oauthAccounts    OAuthAccount[]
  mfaRecoveryCodes MfaRecoveryCode[]
}

// Rotating refresh-token sessions. The opaque refresh token is never stored;
// only its sha256 hash. Rotation revokes the old row and inserts a new one;
// logout sets revokedAt so a token can be invalidated before it expires.
model Session {
  id               String    @id @default(cuid())
  userId           Int
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  MICROSOFT
}

model OAuthAccount {
  id                Int           @id @default(autoincrement())
  userId            Int
  provider          OAuthProvider
  providerAccountId String
  email             String?
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// One-time recovery codes for TOTP 2FA. Only the sha256 hash is stored;
// codes are shown to the user once at enable time.
model MfaRecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Passwordless magic-link tokens. Only the sha256 hash is stored; single-use
// (usedAt) with a short expiry.
model MagicLinkToken {
  id        Int       @id @default(autoincrement())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  planTier           String   @default("FREE")
  razorpayCustomerId String?
  razorpaySubId      String?
  subscriptionStatus String?

  members          WorkspaceMember[]
  monitors         Monitor[]
  webhookEndpoints WebhookEndpoint[]
  apiKeys          ApiKey[]
  workspaceInvites WorkspaceInvite[]
}

model WorkspaceMember {
  id          Int           @id @default(autoincrement())
  userId      Int
  workspaceId Int
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

enum MonitorStatus {
  UP
  DOWN
  DEGRADED
  PAUSED
}

enum MonitorType {
  HTTP
  HEARTBEAT
}

model Monitor {
  id                  Int           @id @default(autoincrement())
  workspaceId         Int
  name                String
  type                MonitorType   @default(HTTP)
  url                 String
  method              String        @default("GET")
  intervalSeconds     Int           @default(60)
  timeoutMs           Int           @default(5000)
  expectedStatus      Int           @default(200)
  gracePeriodSeconds  Int           @default(60)
  status              MonitorStatus @default(UP)
  consecutiveFailures Int           @default(0)
  graceThreshold      Int           @default(3)
  isActive            Boolean       @default(true)
  lastCheckedAt       DateTime?
  lastResponseTime    Int?
  lastStatusCode      Int?
  lastHeartbeatAt     DateTime?
  tlsIssuer           String?
  tlsValidTo          DateTime?
  tlsDaysRemaining    Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  maintenanceStartAt  DateTime?
  maintenanceEndAt    DateTime?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checks    MonitorCheck[]
  incidents Incident[]

  @@index([workspaceId])
}

model MonitorCheck {
  id             Int           @id @default(autoincrement())
  monitorId      Int
  status         MonitorStatus
  statusCode     Int?
  responseTimeMs Int?
  errorMessage   String?
  checkedAt      DateTime      @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([checkedAt])
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Incident {
  id         Int            @id @default(autoincrement())
  monitorId  Int
  status     IncidentStatus @default(OPEN)
  title      String
  startedAt  DateTime       @default(now())
  resolvedAt DateTime?

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([status])
}

enum ApiKeyScope {
  READ_ONLY
  READ_WRITE
}

model ApiKey {
  id          Int         @id @default(autoincrement())
  workspaceId Int
  name        String
  key         String      @unique
  scope       ApiKeyScope @default(READ_ONLY)
  lastUsedAt  DateTime?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WebhookEndpoint {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  name        String   @default("")
  url         String
  events      String   @default("[\"incident.opened\",\"incident.resolved\"]")
  secret      String?
  isActive    Boolean  @default(true)
  lastTestedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  webhookDeliveryLogs WebhookDeliveryLog[]

  @@index([workspaceId])
}

model WebhookDeliveryLog {
  id             Int      @id @default(autoincrement())
  webhookId      Int
  url            String
  requestPayload Json
  responseStatus Int?
  responseBody   String?
  isSuccess      Boolean
  createdAt      DateTime @default(now())

  webhook WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

model WorkspaceInvite {
  id          Int           @id @default(autoincrement())
  workspaceId Int
  token       String        @unique
  email       String?
  role        WorkspaceRole @default(VIEWER)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId])
  @@index([email])
}
