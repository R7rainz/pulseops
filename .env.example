# PulseOps self-host overrides.
#
# You do NOT need this file to run the stack — `docker compose up` works out of
# the box with safe local defaults. Copy it to `.env` only to customise the
# deployment (Docker Compose auto-loads a root `.env` for the values below).
#
#   cp .env.example .env
#
# ⚠️  If your instance is reachable by anyone other than you, CHANGE JWT_SECRET.

# ── Core ──────────────────────────────────────────────────────────────────────
# Auth token signing key (HS256). REQUIRED for any shared/deployed instance.
# Leave blank for pure-localhost use (compose falls back to a dev default).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Postgres credentials. Defaults are fine for a self-contained stack (the DB is
# only reached over the internal network); change them if you expose it.
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=pulseops
POSTGRES_DB=pulseops

# Public URLs. Change these when hosting on a real domain (not localhost).
# APP_URL / FRONTEND_URL — where the web app is served (also CORS + email links).
# PUBLIC_API_URL / OAUTH_CALLBACK_BASE — where the API is reachable by browsers.
# DOCS_URL — where the API-reference docs app is served.
#
# ⚠️  BUILD-TIME: PUBLIC_API_URL, APP_URL and DOCS_URL are baked into the web/docs
#     client bundles at image build (Next inlines NEXT_PUBLIC_*). After changing
#     them you MUST rebuild, not just restart:  docker compose build web docs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
OAUTH_CALLBACK_BASE=http://localhost:4000
DOCS_URL=http://localhost:3001

# ── Production: HTTPS behind Caddy (docker-compose.prod.yml) ──────────────────
# Add the prod overlay to put Caddy in front with automatic Let's Encrypt TLS
# and one-domain, path-based routing (/ → web, /api/v1 → api, /docs → docs):
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml build
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Requires: public DNS A/AAAA record for DOMAIN → this host, and inbound 80/443.
# For a real domain, set DOMAIN and point every public URL above at it:
#
#   APP_URL=https://your.domain
#   FRONTEND_URL=https://your.domain
#   PUBLIC_API_URL=https://your.domain
#   OAUTH_CALLBACK_BASE=https://your.domain
#   DOCS_URL=https://your.domain/docs
#
DOMAIN=your.domain
# Optional — for Let's Encrypt certificate-expiry notices (also uncomment the
# global block in caddy/Caddyfile to use it).
ACME_EMAIL=

# ── Optional features ─────────────────────────────────────────────────────────
# These are OFF by default and the app runs fine without them. To enable, put
# the real secrets in `backend/.env` (loaded automatically if present):
#
#   • Social login   — GOOGLE_/GITHUB_/MICROSOFT_CLIENT_ID + _SECRET
#   • Email          — SMTP_HOST/PORT/USER/PASS/FROM
#                      (unset ⇒ magic links & invites are logged to the API console)
#   • Billing        — RAZORPAY_KEY_ID/_SECRET/_WEBHOOK_SECRET/_PRO_PLAN_ID
#
# See backend/CLAUDE.md for the full list.
