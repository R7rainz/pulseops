# PulseOps self-host overrides.
#
# You do NOT need this file to run the stack — `docker compose up` works out of
# the box with safe local defaults. Copy it to `.env` only to customise the
# deployment (Docker Compose auto-loads a root `.env` for the values below).
#
#   cp .env.example .env
#
# ⚠️  If your instance is reachable by anyone other than you, CHANGE JWT_SECRET.

# ── Core ──────────────────────────────────────────────────────────────────────
# Auth token signing key (HS256). Generate one with:  openssl rand -hex 32
JWT_SECRET=a3f1c09e7b2d48561fae90c3d7b6528e14aa9f0c5d3e2b7a8c6f4e1d0b9a8c7d

# Public URLs. Change these when hosting on a real domain (not localhost).
# APP_URL / FRONTEND_URL — where the web app is served (also CORS + email links).
# PUBLIC_API_URL / OAUTH_CALLBACK_BASE — where the API is reachable.
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
OAUTH_CALLBACK_BASE=http://localhost:4000

# ── Optional features ─────────────────────────────────────────────────────────
# These are OFF by default and the app runs fine without them. To enable, put
# the real secrets in `backend/.env` (loaded automatically if present):
#
#   • Social login   — GOOGLE_/GITHUB_/MICROSOFT_CLIENT_ID + _SECRET
#   • Email          — SMTP_HOST/PORT/USER/PASS/FROM
#                      (unset ⇒ magic links & invites are logged to the API console)
#   • Billing        — RAZORPAY_KEY_ID/_SECRET/_WEBHOOK_SECRET/_PRO_PLAN_ID
#
# See backend/CLAUDE.md for the full list.
