# pulseops MCP server environment.
#
# The MCP server reuses the CLI's config resolver, so it authenticates with a
# workspace API key (env only — no flags). The model never picks a workspace; it
# is fixed from PULSEOPS_WORKSPACE.

# API base URL of your (self-hosted) PulseOps backend.
PULSEOPS_API_URL=http://localhost:4000

# Workspace API key (po_…) and the workspace it is scoped to. Both required.
PULSEOPS_API_KEY=
PULSEOPS_WORKSPACE=

# The server is read-only by default. Set to 1 to also expose the one write-ish
# tool, `pulseops_send_heartbeat` (push a heartbeat for HEARTBEAT monitors).
PULSEOPS_MCP_ALLOW_HEARTBEAT=0
